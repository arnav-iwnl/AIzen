# AIzen v2 — environment (example)
# Copy to v2/.env if you add local non-default overrides.

# Force CPU even if CUDA is present (useful for CI / debugging)
# V2_FORCE_CPU=1

# Cap rows loaded from ballot (dev/CI). Unset for full.
# V2_MAX_ROWS=20000

# ── Kaggle (for kaggle_ingest.py) ───────────────────────────────────────
# Works with kaggle 2.x. Provide EITHER the legacy pair (or ~/.kaggle/kaggle.json)
# OR the newer API token:
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_key
# KAGGLE_API_TOKEN=kaggle_api_token       # alternative (preferred in 2.2.4)

# ── Hugging Face (optional token only if a dataset requires gated access) ──
# HF_TOKEN=hf_xxx
